# Copy to .env (never commit .env) and replace every value marked "change-me".

# Django
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=false
# EC2 public IP or DNS name, plus localhost for the container healthcheck
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<EC2-PUBLIC-IP>
DJANGO_CSRF_TRUSTED_ORIGINS=http://<EC2-PUBLIC-IP>:8000
# Set to true only after HTTPS is configured
DJANGO_SECURE_COOKIES=false

# PostgreSQL (used by both the db container and Django)
POSTGRES_DB=photomatch
POSTGRES_USER=photomatch
POSTGRES_PASSWORD=change-me

# Admin user created on first start
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Load the demo event on start (idempotent)
SEED_DEMO=true

# Host port published by the web container
WEB_PORT=8000

# Face search
MATCH_THRESHOLD=0.60
# Serve photos from local folders instead of S3 (development; see docker-compose.override.example.yml)
LOCAL_PHOTOS_ENABLED=false
# Optional: S3 bucket with the real event photos (EC2 instance role needs s3:GetObject)
# Layout: <bucket>/dataset/<event folder>/<photo>  and  <bucket>/thumb/<event folder>/<photo>.jpg
S3_BUCKET=
S3_IMAGE_PREFIX=dataset/
S3_THUMBNAIL_PREFIX=thumb/
# Region of the bucket, used to sign the photo URLs
AWS_DEFAULT_REGION=us-east-1
